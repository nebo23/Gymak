{
  "components": {
    "schemas": {
      "AuthMeResponse": {
        "description": "\u00a75.7: \"One round trip decides the whole navigation state.\" `profile` is null\nuntil onboarding completes, then the same shape POST/GET/PATCH /profile return.",
        "properties": {
          "onboarding_completed": {
            "title": "Onboarding Completed",
            "type": "boolean"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProfileData"
              },
              {
                "type": "null"
              }
            ]
          },
          "user": {
            "$ref": "#/components/schemas/AuthMeUser"
          }
        },
        "required": [
          "user",
          "onboarding_completed",
          "profile"
        ],
        "title": "AuthMeResponse",
        "type": "object"
      },
      "AuthMeUser": {
        "description": "\u00a75.7's `user` object. `auth_methods` lists \"password\" (if a password is set)\nfollowed by every linked social provider -- see auth_service.get_me.",
        "properties": {
          "auth_methods": {
            "items": {
              "type": "string"
            },
            "title": "Auth Methods",
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "email_verified",
          "created_at",
          "auth_methods"
        ],
        "title": "AuthMeUser",
        "type": "object"
      },
      "DeleteAccountRequest": {
        "additionalProperties": false,
        "description": "\u00a75.10: \"password required when password_hash is not null; omitted for\nsocial-only accounts.\" `password` is optional at the schema level -- whether it\nis actually required depends on the authenticated user's row, which the schema\ncannot see, so auth_service.delete_account enforces that. A social-only caller\nstill sends a JSON object (`{}`); FastAPI has no body to parse from a request\nwith no content at all, only from an empty object.",
        "properties": {
          "password": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Password"
          }
        },
        "title": "DeleteAccountRequest",
        "type": "object"
      },
      "DeleteAccountResponse": {
        "description": "\u00a75.10's exact 202 shape.",
        "properties": {
          "deletion_requested_at": {
            "format": "date-time",
            "title": "Deletion Requested At",
            "type": "string"
          },
          "purge_after_days": {
            "default": 30,
            "title": "Purge After Days",
            "type": "integer"
          }
        },
        "required": [
          "deletion_requested_at"
        ],
        "title": "DeleteAccountResponse",
        "type": "object"
      },
      "DerivedFields": {
        "description": "\u00a75.8: \"age is computed, never stored.\" ",
        "properties": {
          "age": {
            "title": "Age",
            "type": "integer"
          }
        },
        "required": [
          "age"
        ],
        "title": "DerivedFields",
        "type": "object"
      },
      "ForgotPasswordRequest": {
        "additionalProperties": false,
        "description": "\u00a75.6 call 1. `email` is the only field -- deliberately unauthenticated.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "ForgotPasswordRequest",
        "type": "object"
      },
      "ForgotPasswordResponse": {
        "description": "\u00a75.6: the exact same body regardless of whether the account exists.",
        "properties": {
          "message": {
            "default": "If an account exists for that address, a code has been sent.",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "ForgotPasswordResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LogoutRequest": {
        "additionalProperties": false,
        "description": "\u00a75's /auth/logout. The access token identifies the caller; it carries no\nfamily_id (P1-ADR-02's claim list), so the refresh token is what tells the server\nwhich family to revoke.",
        "properties": {
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "LogoutRequest",
        "type": "object"
      },
      "ProfileCreateRequest": {
        "additionalProperties": false,
        "description": "\u00a75.8. birth_date is a plain str (not a pydantic `date`), deliberately -- see the\nmodule docstring: a malformed date string must reach profile_service as a\nVALIDATION_ERROR, not FastAPI's default body.",
        "properties": {
          "activity_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Activity Level"
          },
          "birth_date": {
            "title": "Birth Date",
            "type": "string"
          },
          "experience_level": {
            "title": "Experience Level",
            "type": "string"
          },
          "gender": {
            "title": "Gender",
            "type": "string"
          },
          "goal": {
            "title": "Goal",
            "type": "string"
          },
          "height_cm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Height Cm"
          },
          "language": {
            "default": "ar",
            "title": "Language",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "unit_system": {
            "default": "metric",
            "title": "Unit System",
            "type": "string"
          },
          "weight_kg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weight Kg"
          }
        },
        "required": [
          "name",
          "gender",
          "birth_date",
          "height_cm",
          "goal",
          "experience_level"
        ],
        "title": "ProfileCreateRequest",
        "type": "object"
      },
      "ProfileCreateResponse": {
        "properties": {
          "derived": {
            "$ref": "#/components/schemas/DerivedFields"
          },
          "profile": {
            "$ref": "#/components/schemas/ProfileData"
          }
        },
        "required": [
          "profile",
          "derived"
        ],
        "title": "ProfileCreateResponse",
        "type": "object"
      },
      "ProfileData": {
        "description": "The full profile object shape shared by /auth/me, and the POST/GET/PATCH\n/profile responses (\u00a75.7, \u00a75.8, \u00a75.9).",
        "properties": {
          "activity_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Activity Level"
          },
          "birth_date": {
            "format": "date",
            "title": "Birth Date",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "experience_level": {
            "title": "Experience Level",
            "type": "string"
          },
          "gender": {
            "title": "Gender",
            "type": "string"
          },
          "goal": {
            "title": "Goal",
            "type": "string"
          },
          "height_cm": {
            "title": "Height Cm",
            "type": "number"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "onboarding_completed": {
            "title": "Onboarding Completed",
            "type": "boolean"
          },
          "unit_system": {
            "title": "Unit System",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "weight_kg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weight Kg"
          }
        },
        "required": [
          "name",
          "gender",
          "birth_date",
          "height_cm",
          "weight_kg",
          "goal",
          "experience_level",
          "activity_level",
          "unit_system",
          "language",
          "onboarding_completed",
          "created_at",
          "updated_at"
        ],
        "title": "ProfileData",
        "type": "object"
      },
      "ProfileResponse": {
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/ProfileData"
          }
        },
        "required": [
          "profile"
        ],
        "title": "ProfileResponse",
        "type": "object"
      },
      "ProfileUpdateRequest": {
        "additionalProperties": false,
        "description": "\u00a75.9's editable/immutable table. Every field is optional so `model_dump(\nexclude_unset=True)` in profile_service tells \"not sent\" from \"sent\", which is what\n\"only the keys present in the body are touched\" (partial update) requires.\n\n`onboarding_completed` is declared explicitly, and only so `extra=\"forbid\"` does not\nreject it -- \u00a75.9: \"Server-controlled. A client sending it is ignored, not\nrejected.\" profile_service never reads this field.",
        "properties": {
          "activity_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Activity Level"
          },
          "birth_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Birth Date"
          },
          "experience_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Experience Level"
          },
          "gender": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gender"
          },
          "goal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal"
          },
          "height_cm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height Cm"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "onboarding_completed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Onboarding Completed"
          },
          "unit_system": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit System"
          },
          "weight_kg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weight Kg"
          }
        },
        "title": "ProfileUpdateRequest",
        "type": "object"
      },
      "RefreshRequest": {
        "additionalProperties": false,
        "description": "\u00a75.5. The opaque refresh token is the only field -- there is no bearer here.",
        "properties": {
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "RegisterRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "language": {
            "default": "ar",
            "title": "Language",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "ResetPasswordRequest": {
        "additionalProperties": false,
        "description": "\u00a75.6 call 3. No email here -- the reset token alone identifies the account.",
        "properties": {
          "new_password": {
            "title": "New Password",
            "type": "string"
          },
          "reset_token": {
            "title": "Reset Token",
            "type": "string"
          }
        },
        "required": [
          "reset_token",
          "new_password"
        ],
        "title": "ResetPasswordRequest",
        "type": "object"
      },
      "SocialSignInRequest": {
        "description": "\u00a75.4. \"The body carries exactly one field: id_token.\" Deliberately NOT\nextra=\"forbid\" like this module's other request schemas: \u00a75.4's own security note --\n\"the provider, the uid, and the email all come from the verified token -- never from\nthe request body\" -- means an attacker-supplied `email` or `provider` alongside a\nvalid id_token must be silently ignored, not rejected as an unknown field. See\ntest_social_auth.py's body-field-ignored control test.",
        "properties": {
          "id_token": {
            "title": "Id Token",
            "type": "string"
          }
        },
        "required": [
          "id_token"
        ],
        "title": "SocialSignInRequest",
        "type": "object"
      },
      "SocialSignInResponse": {
        "description": "\u00a75.4: identical shape to register/login's token pair, plus is_new_user so the\nclient knows whether to route to onboarding or home.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "is_new_user": {
            "title": "Is New User",
            "type": "boolean"
          },
          "refresh_expires_in": {
            "title": "Refresh Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserSummary"
          }
        },
        "required": [
          "access_token",
          "expires_in",
          "refresh_token",
          "refresh_expires_in",
          "user",
          "is_new_user"
        ],
        "title": "SocialSignInResponse",
        "type": "object"
      },
      "TokenPairResponse": {
        "description": "Identical shape for register (\u00a75.2) and login (\u00a75.3).",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_expires_in": {
            "title": "Refresh Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserSummary"
          }
        },
        "required": [
          "access_token",
          "expires_in",
          "refresh_token",
          "refresh_expires_in",
          "user"
        ],
        "title": "TokenPairResponse",
        "type": "object"
      },
      "UserSummary": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "onboarding_completed": {
            "title": "Onboarding Completed",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "onboarding_completed"
        ],
        "title": "UserSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerifyCodeRequest": {
        "additionalProperties": false,
        "description": "\u00a75.6 call 2. `code` is validated by attempting a match, not by a schema-level\nshape check -- see password_reset_service: a malformed code cannot match any\nstored digest, so it already surfaces as RESET_CODE_INVALID (\u00a77.1) through the\nsame path a wrong-but-well-formed code takes, with no separate rule to keep in\nsync with P1-ADR-07's alphabet.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email",
          "code"
        ],
        "title": "VerifyCodeRequest",
        "type": "object"
      },
      "VerifyCodeResponse": {
        "description": "\u00a75.6: opaque, single-purpose, single-use, 5 minutes.",
        "properties": {
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "reset_token": {
            "title": "Reset Token",
            "type": "string"
          }
        },
        "required": [
          "reset_token",
          "expires_in"
        ],
        "title": "VerifyCodeResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Gymak API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/account": {
      "delete": {
        "operationId": "delete_account_route_api_v1_account_delete",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteAccountRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteAccountResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete Account Route",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login_route_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPairResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login Route",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout_route_api_v1_auth_logout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Logout Route",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "operationId": "logout_all_route_api_v1_auth_logout_all_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Logout All Route",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "get_me_route_api_v1_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Me Route",
        "tags": [
          "auth"
        ]
      }
    },
