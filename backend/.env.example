ENV=development                       # development | test | staging | production
DATABASE_URL=postgresql+asyncpg://gymak_app:pass@localhost:5432/gymak
                                       # example only, not a correct default — the port may
                                       # differ locally if 5432 is already taken (see README:
                                       # `netstat -ano | findstr :5432`, use 5433 instead)
                                       # A.5 item 1: gymak_app is DML-only — SELECT/INSERT/
                                       # UPDATE/DELETE on specific tables, never CREATE/ALTER/
                                       # DROP. The running application (uvicorn) uses only this
                                       # value; it never reads MIGRATOR_DATABASE_URL below.
MIGRATOR_DATABASE_URL=postgresql+asyncpg://gymak_migrator:pass@localhost:5432/gymak
                                       # REQUIRED for `alembic upgrade`/`downgrade` only — read by
                                       # alembic/env.py, never by the application. gymak_migrator
                                       # owns the schema: it is the only role that can CREATE
                                       # TABLE, ALTER TABLE, or CREATE EXTENSION citext, and
                                       # `alembic upgrade head` runs those with no other manual
                                       # step (A.5 item 11 — citext is a Postgres 13+ "trusted"
                                       # extension: a non-superuser role with CREATE on the
                                       # database, not superuser, can install it). Not required
                                       # for `uvicorn` to start — the app never connects as this
                                       # role (see app/database.py's startup assertion).
JWT_PRIVATE_KEY_PEM=                  # Ed25519 private key, PEM, base64 if multiline is awkward
JWT_PUBLIC_KEY_PEM=
JWT_AUDIENCE=gymak-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=5184000
RESET_CODE_TTL_SECONDS=600
RESET_TOKEN_TTL_SECONDS=300
RESET_CODE_PEPPER=                    # REQUIRED (spec P1-ADR-07) — HMAC key for reset-code hashing.
                                      # No default, fails at import if missing, like the JWT keys:
                                      # a missing pepper must never silently degrade to an unkeyed
                                      # hash. Never stored in the database; rotating it invalidates
                                      # every outstanding reset code (10 min TTL, so that is cheap).
                                      # Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
FIREBASE_PROJECT_ID=gymak-2d4ab
FIREBASE_CREDENTIALS_JSON=            # service account JSON, one line
EMAIL_BACKEND=console                 # console | http
EMAIL_API_KEY=
EMAIL_FROM="Gymak <no-reply@gymak.fitness>"
REDIS_URL=                            # optional in Phase 1
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
                                       # comma-separated, no wildcard. Add your LAN IP here for
                                       # a physical device or Expo web during development, e.g.:
                                       # CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://192.168.1.10:8081
LOG_LEVEL=INFO
