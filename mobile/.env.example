EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000/api/v1
                                       # Expo only exposes vars prefixed EXPO_PUBLIC_ to client
                                       # code (everything else is build-time/server-only and
                                       # invisible to the bundle). Point this at the backend's
                                       # LAN IP, not localhost — a physical device cannot reach
                                       # the dev machine's loopback address. See
                                       # backend/README.md "Find the LAN IP" and add that
                                       # address to the backend's CORS_ORIGINS too.
                                       # This is also the value EAS Build needs directly — a
                                       # local .env is gitignored and never reaches EAS's cloud
                                       # workers, so development/preview builds get this from
                                       # eas.json's own env block instead (kept in sync by hand).

# §8.1/§8.3/A.1 — Firebase, Google only (Facebook deferred to Phase 2, 13.1.2).
# @react-native-firebase auto-configures its native SDK from the platform
# config file (android/app/google-services.json, wired into the build by
# app.json's googleServicesFile + the @react-native-firebase/app config
# plugin) — none of the four EXPO_PUBLIC_FIREBASE_* values below are read by
# any T-13 code. They are filled in anyway, from the same already-committed
# google-services.json, purely so Appendix A.1's mobile block has a value in
# every slot it names; a future screen that talks to the JS-only Firebase Web
# SDK directly (none does today) would need them.
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBmilkSx6014I8mIljeo5mUq8ZAzMTfi_8
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=gymak-2d4ab.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=gymak-2d4ab
EXPO_PUBLIC_FIREBASE_APP_ID=1:603892086493:android:8fb56da5186fc4b77a8d34
# The "client_type": 3 (Web) OAuth client from google-services.json's
# oauth_client array — GoogleSignin.configure()'s webClientId (src/auth/
# firebase.ts). This one specific client is required, not the Android one:
# it is what makes the ID token's audience something firebase-admin/Google
# can verify across platforms. Not a secret — it identifies the OAuth
# client, not a key.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=603892086493-119ivapgkun56qrhog6077iedrc5mbvj.apps.googleusercontent.com