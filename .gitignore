.env
.env.local
__pycache__/
*.pyc
.venv/
node_modules/
.expo/
dist/
*-service-account*.json

# coverage.py has no data_file set, so .coverage lands in whatever directory
# pytest was invoked from -- backend/ for the per-task gate, the repo root when
# someone runs it from there. Only the first was ignored, so the root one showed
# up as an untracked file.
**/.coverage

*.jks
*.keystore

# Local device-verification scratch output (screenshots, uiautomator dumps, run logs)
scratch-*.png
scratch-*.xml
emulator.log
emulator-err.log
expo-run.log
metro.log
uvicorn.log
